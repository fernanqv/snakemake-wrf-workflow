# # Instructions to run this workflow in altamira:
#
# # FIRST TIME ONLY
# git worktree add config/profiles hpc-profiles # this will load 'altamira' profile under 'config/profiles/altamira/'
# # FOR EVERY WORKFLOW RUN
# pixi run hpc-profile altamira

configfile: "config/config.yaml"

import os
from itertools import product
from pathlib import Path
from shlex import quote

# Project's REPO_ROOT Path
REPO_ROOT = config.get(
    "repo_root_custom",
    os.path.dirname(os.path.dirname(os.path.abspath(workflow.snakefile)))
)
PATH_KEYS = [
    "grib_basedir", "run_dir", "geog_data_path", "geo_em_path",
    "namelist_wps", "namelist_input", "wps_install_dir", "wrf_install_dir"
]
for key in PATH_KEYS:
    if key in config:
        if not os.path.isabs(config[key]):
            config[key] = os.path.join(REPO_ROOT, config[key])

ERA5_DOMAIN = config["era5_domain"]
config["geo_em_path"] = config["geo_em_path"].format(era5_domain=ERA5_DOMAIN)

# Environment Initialization
RUN_BASE_DIR_TEMPLATE = config["run_dir"]
GRIB_BASE_DIR = config["grib_basedir"]
GEO_EM_PATH = config["geo_em_path"]

WPS_VERSION = config["wps_version"]
WRF_VERSION = config["wrf_version"]
TOOLCHAIN_SUFFIX = config.get("toolchain_suffix", "")

WRF_INSTALL_DIR = config["wrf_install_dir"]
WPS_INSTALL_DIR = config["wps_install_dir"]
WRF_BIN_DIR = f"{WRF_INSTALL_DIR}/bin"
WPS_BIN_DIR = f"{WPS_INSTALL_DIR}/bin"

os.makedirs(WRF_BIN_DIR, exist_ok=True)
os.makedirs(WPS_BIN_DIR, exist_ok=True)

# Software paths
eb_wrf_source = os.path.join(WRF_INSTALL_DIR, f"software/WRF/{WRF_VERSION}{TOOLCHAIN_SUFFIX}/WRFV{WRF_VERSION}")
eb_wps_source = os.path.join(WPS_INSTALL_DIR, f"software/WPS/{WPS_VERSION}{TOOLCHAIN_SUFFIX}/WPS-{WPS_VERSION}")

if os.path.exists(eb_wps_source):
    WRF_INSTALL_DIR = eb_wrf_source
    WPS_INSTALL_DIR = eb_wps_source

# EESSI
EESSI_INIT = quote(config["eessi_init_script"])
common_runtime_env = (
    f"set +u; source {EESSI_INIT}; module load EESSI-extend; set -u;"
)
WRF_RUNTIME_ENV = (
    f"{common_runtime_env} module load "
    f"WRF/{WRF_VERSION}{TOOLCHAIN_SUFFIX};"
)
WPS_RUNTIME_ENV = (
    f"{common_runtime_env} module load "
    f"WPS/{WPS_VERSION}{TOOLCHAIN_SUFFIX};"
)

MONTHS = [f"{month:02d}" for month in range(11, 12)]
ERA5_FILETYPES = ["pl", "sl"]
GEO_EM_PATH = config["geo_em_path"].format(era5_domain=ERA5_DOMAIN)
GEOG_DATA_PATH = str(Path(config["geog_data_path"]))
GEOG_DATA_URL = config.get(
    "geog_data_url",
    "https://www2.mmm.ucar.edu/wrf/src/wps_files/geog_low_res_mandatory.tar.gz",
)
GEOG_DATA_INDEX = str(Path(GEOG_DATA_PATH) / "topo_gmted2010_5m" / "index")
WRF_RUN_EXCLUDE_PATTERNS = ["wrf*", "*.exe", "README*", "*rsl*", "namelist.*"]
WRF_RUN_FIND_EXCLUDES = " ".join(
    f"! -name {quote(pattern)}" for pattern in WRF_RUN_EXCLUDE_PATTERNS
)

def get_run_dir(year):
    """Expand run_dir template with domain and year"""
    return RUN_BASE_DIR_TEMPLATE.format(year=year)

rule all:
    input:
        [str(Path(get_run_dir(year)) / "wrf.done") for year in config["runs"]]

localrules: all, namelist_wps, namelist_wps_geogrid, namelist_input

# ==============================================================================
# INTEGRATION WITH WRF/WPS COMPILATION MODULE
# ==============================================================================
COMPILATION_REPO    = config.get("compilation_repo", "orviz/snakemake-wrf-wps-compilation")
COMPILATION_VERSION = config.get("compilation_version", "0.5.0")
COMPILATION_ENABLED = config.get("enable_compilation", False)

module wrf_wps_compilation:
    snakefile: f"gh:{COMPILATION_REPO}@{COMPILATION_VERSION}:workflow/Snakefile"
    config: config

if COMPILATION_ENABLED:
    use rule audit_wps_status from wrf_wps_compilation as compilation_audit_wps
    use rule audit_wrf_status from wrf_wps_compilation as compilation_audit_wrf

    # FORZADO DE RUTAS ABSOLUTAS: Sincroniza el puzle del DAG en tu repositorio local
    use rule compile_wps_via_eb from wrf_wps_compilation as compilation_exec_wps with:
        input:
            wps_json  = "audit/WPS_status.json",
            wrf_json  = "audit/WRF_status.json",
            # Forzamos a que la entrada cruzada use EXACTAMENTE tu misma variable local
            wrf_ready = f"{WRF_BIN_DIR}/wrf.exe"
        output:
            f"{WPS_BIN_DIR}/geogrid.exe",
            f"{WPS_BIN_DIR}/ungrib.exe",
            f"{WPS_BIN_DIR}/metgrid.exe"

    use rule compile_wrf_via_eb from wrf_wps_compilation as compilation_exec_wrf with:
        output:
            f"{WRF_BIN_DIR}/real.exe",
            f"{WRF_BIN_DIR}/wrf.exe"

    WPS_DEP = [
        f"{WPS_BIN_DIR}/geogrid.exe",
        f"{WPS_BIN_DIR}/ungrib.exe",
        f"{WPS_BIN_DIR}/metgrid.exe"
    ]
    WRF_DEP = [
        f"{WRF_BIN_DIR}/real.exe",
        f"{WRF_BIN_DIR}/wrf.exe"
    ]
# ==============================================================================

rule namelist_wps:
    output:
        str(Path(RUN_BASE_DIR_TEMPLATE) / "namelist.wps")
    params:
        geog_data_path=str(Path(config["geog_data_path"])),
        geo_em_path=GEO_EM_PATH,
        namelist_wps=config["namelist_wps"],
        GEOGRID_TBL=config["GEOGRID.TBL"],
        wps_dir=WPS_INSTALL_DIR,
        run_dir=lambda wildcards: get_run_dir(wildcards.year),
    shell:
        """
        mkdir -p {params.run_dir}
        cd {params.run_dir}
        jinja2 {params.namelist_wps} \
            -D start_year={wildcards.year} \
            -D end_year={wildcards.year} \
            -D geog_data_path={params.geog_data_path} \
            -o namelist.wps
        """

rule namelist_wps_geogrid:
    output:
        str(Path(GEO_EM_PATH) / "namelist.wps")
    params:
        geog_data_path=str(Path(config["geog_data_path"])),
        geo_em_path=GEO_EM_PATH,
        namelist_wps=config["namelist_wps"],
    shell:
        """
        mkdir -p {params.geo_em_path}
        cd {params.geo_em_path}
        jinja2 {params.namelist_wps} \
            -D geog_data_path={params.geog_data_path} \
            -o namelist.wps
        """

rule namelist_input:
    output:
        str(Path(RUN_BASE_DIR_TEMPLATE) / "namelist.input")
    params:
        run_dir=lambda wildcards: get_run_dir(wildcards.year),
        namelist_input_template=str(Path(config["namelist_input"])),
    shell:
        """
        mkdir -p {params.run_dir}
        cd {params.run_dir}
        jinja2 {params.namelist_input_template} \
            -D start_year={wildcards.year} \
            -D end_year={wildcards.year} \
            -o namelist.input
        """

rule download_wps_geog:
    output:
        GEOG_DATA_INDEX
    params:
        url=GEOG_DATA_URL,
        target_dir=GEOG_DATA_PATH,
        required_file="topo_gmted2010_5m/index",
    shell:
        """
        bash workflow/scripts/download_wps_geog.sh \
            {params.url:q} \
            {params.target_dir:q} \
            {params.required_file:q}
        """


rule geogrid:
    input:
        geog_data=GEOG_DATA_INDEX,
        namelist_wps=str(Path(GEO_EM_PATH) / "namelist.wps"),
        compilation=WPS_DEP
    output:
        done = str(Path(GEO_EM_PATH) / "geogrid.done"),
        nc   = str(Path(GEO_EM_PATH) / "geo_em.d01.nc")
    params:
        geo_em_path=GEO_EM_PATH,
        namelist_wps=config["namelist_wps"],
        GEOGRID_TBL=config["GEOGRID.TBL"],
        wps_install_dir=WPS_INSTALL_DIR,
        runtime_env=WPS_RUNTIME_ENV,
    resources:
        tasks= 2,
        mpi= "mpirun",
    shell:
        """
        {params.runtime_env}

        cd {params.geo_em_path}
        mkdir -p geogrid

        ln -sf {params.wps_install_dir}/geogrid/{params.GEOGRID_TBL} geogrid/GEOGRID.TBL

        {resources.mpi} -n {resources.tasks} geogrid.exe

        test -s geo_em.d01.nc
        touch {output}
        """

rule download_ERA5:
    output:
        f"{GRIB_BASE_DIR}/{{domain}}/{{year}}/ERA5-{{year}}{{month}}-{{filetype}}.grib"
    params:
        data_dir=GRIB_BASE_DIR,
    shell:
        """
        echo "Running: python ERA5/retrieve_era5.py {wildcards.year} {wildcards.month} {wildcards.filetype} {params.data_dir} {wildcards.domain}"
        python ERA5/retrieve_era5_days4_6.py {wildcards.year} {wildcards.month} {wildcards.filetype} {params.data_dir} {wildcards.domain}
        """

rule ungrib:
    input:
        gribs=lambda wildcards: expand(
            f"{GRIB_BASE_DIR}/{ERA5_DOMAIN}/{{year}}/ERA5-{{year}}{{month}}-{{filetype}}.grib",
            year=wildcards.year,
            month=MONTHS,
            filetype=ERA5_FILETYPES,
        ),
        namelist_wps=lambda wildcards: str(Path(get_run_dir(wildcards.year)) / "namelist.wps"),
        compilation=WPS_DEP
    output:
        str(Path(RUN_BASE_DIR_TEMPLATE) / "ungrib.done")
    params:
        grib_dir=lambda wildcards: str(Path(GRIB_BASE_DIR) / ERA5_DOMAIN / wildcards.year),
        run_dir=lambda wildcards: get_run_dir(wildcards.year),
        VTable=config["Vtable"],
        wps_install_dir=WPS_INSTALL_DIR,
        runtime_env=WPS_RUNTIME_ENV,
    shell:
        """
        {params.runtime_env}

        mkdir -p {params.run_dir}
        cd {params.run_dir}

        # Link GRIB files
        {params.wps_install_dir}/link_grib.csh {params.grib_dir}/*.grib

        # Link Vtable
        ln -sf {params.wps_install_dir}/ungrib/Variable_Tables/{params.VTable} Vtable

        ungrib.exe

        touch {output}
        """

rule metgrid:
    input:
        ungrib=lambda wildcards: str(Path(get_run_dir(wildcards.year)) / "ungrib.done"),
        geogrid_done=str(Path(GEO_EM_PATH) / "geogrid.done"),
        geogrid_nc=str(Path(GEO_EM_PATH) / "geo_em.d01.nc"),
        compilation=WPS_DEP
    output:
        str(Path(RUN_BASE_DIR_TEMPLATE) / "metgrid.done")
    params:
        run_dir=lambda wildcards: get_run_dir(wildcards.year),
        METGRID_TBL=config["METGRID.TBL"],
        wps_install_dir=WPS_INSTALL_DIR,
        runtime_env=WPS_RUNTIME_ENV,
    resources:
        tasks= 2,
        mpi= "mpirun",
    shell:
        """
        {params.runtime_env}

        echo "Running metgrid for year {wildcards.year} in {params.run_dir}"
        cd {params.run_dir}
        mkdir -p metgrid

        ln -sf {input.geogrid_nc} ./geo_em.d01.nc

        ln -sf {params.wps_install_dir}/metgrid/{params.METGRID_TBL} metgrid/METGRID.TBL

        {resources.mpi} -n {resources.tasks} metgrid.exe

        touch {output}
        """

rule real:
    input:
        metgrid=lambda wildcards: str(Path(get_run_dir(wildcards.year)) / "metgrid.done"),
        namelist_input=lambda wildcards: str(Path(get_run_dir(wildcards.year)) / "namelist.input"),
        compilation=WRF_DEP
    output:
        str(Path(RUN_BASE_DIR_TEMPLATE) / "real.done")
    params:
        year=lambda wildcards: wildcards.year,
        run_dir=lambda wildcards: get_run_dir(wildcards.year),
        runtime_env=WRF_RUNTIME_ENV,
    resources:
        tasks= 2,
        mpi= "mpirun",
    shell:
        """
        {params.runtime_env}

        echo "Running real for year {params.year} in {params.run_dir}"
        cd {params.run_dir}

        {resources.mpi} -n {resources.tasks} real.exe

        touch {output}
        """

rule wrf:
    input:
        real=lambda wildcards: str(Path(get_run_dir(wildcards.year)) / "real.done"),
        compilation=WRF_DEP
    output:
        str(Path(RUN_BASE_DIR_TEMPLATE) / "wrf.done")
    params:
        run_dir=lambda wildcards: get_run_dir(wildcards.year),
        wrf_run_dir=str(Path(WRF_INSTALL_DIR) / "run"),
        wrf_run_find_excludes=WRF_RUN_FIND_EXCLUDES,
        runtime_env=WRF_RUNTIME_ENV,
    resources:
        tasks=16,
        mpi="mpirun",
    shell:
        """
        {params.runtime_env}

        echo "Running wrf for year {wildcards.year} in {params.run_dir}"
        mkdir -p {params.run_dir}
        cd {params.run_dir}

        find {params.wrf_run_dir} -maxdepth 1 -mindepth 1 \
            {params.wrf_run_find_excludes} \
            -exec ln -sf {{}} . \\;

        echo "{resources.mpi} -n {resources.tasks} wrf.exe"
        {resources.mpi} -n {resources.tasks} wrf.exe

        touch {output}
        """
