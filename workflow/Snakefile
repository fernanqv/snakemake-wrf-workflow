# # Instructions to run this workflow in altamira:
#
# # FIRST TIME ONLY
# git worktree add config/profiles hpc-profiles # this will load 'altamira' profile under 'config/profiles/altamira/'
# # FOR EVERY WORKFLOW RUN
# pixi run hpc-profile altamira

from itertools import product
from pathlib import Path
from shlex import quote

configfile: "config/config.yaml"

RUN_BASE_DIR_TEMPLATE = config["run_dir"]
GRIB_BASE_DIR = config["grib_basedir"]

EESSI_INIT = quote(config["eessi_init_script"])
TOOLCHAIN_SUFFIX = config.get("toolchain_suffix", "")

WRF_INSTALL_DIR = config["wrf_install_dir"]
WPS_INSTALL_DIR = config["wps_install_dir"]
WPS_VERSION = config["wps_version"]
WRF_VERSION = config["wrf_version"]
WPS_SOURCE_DIR = f"{config['wps_eb_root']}/WPS-{WPS_VERSION}"

common_runtime_env = (
    f"set +u; source {EESSI_INIT}; module load EESSI-extend; set -u;"
)
WPS_RUNTIME_ENV = (
    f"{common_runtime_env} module load "
    f"WPS/{WPS_VERSION}{TOOLCHAIN_SUFFIX};"
)
WRF_RUNTIME_ENV = (
    f"{common_runtime_env} module load "
    f"WRF/{WRF_VERSION}{TOOLCHAIN_SUFFIX};"
)

ERA5_DOMAIN = config["era5_domain"]
MONTHS = [f"{month:02d}" for month in range(11, 12)]
ERA5_FILETYPES = ["pl", "sl"]
GEO_EM_PATH = config["geo_em_path"].format(era5_domain=ERA5_DOMAIN)
GEOG_DATA_PATH = str(Path(config["geog_data_path"]))
GEOG_DATA_URL = config.get(
    "geog_data_url",
    "https://www2.mmm.ucar.edu/wrf/src/wps_files/geog_low_res_mandatory.tar.gz",
)
GEOG_DATA_INDEX = str(Path(GEOG_DATA_PATH) / "topo_gmted2010_5m" / "index")
WRF_RUN_EXCLUDE_PATTERNS = ["wrf*", "*.exe", "README*", "*rsl*", "namelist.*"]
WRF_RUN_FIND_EXCLUDES = " ".join(
    f"! -name {quote(pattern)}" for pattern in WRF_RUN_EXCLUDE_PATTERNS
)

def get_run_dir(year):
    """Expand run_dir template with domain and year"""
    return RUN_BASE_DIR_TEMPLATE.format(year=year)

rule all:
    input:
        [str(Path(get_run_dir(year)) / "wrf.done") for year in config["runs"]]

localrules: all, namelist_wps, namelist_wps_geogrid, namelist_input

# ==============================================================================
# INTEGRATION WITH WRF/WPS COMPILATION MODULE
# ==============================================================================
COMPILATION_REPO    = config.get("compilation_repo", "orviz/snakemake-wrf-wps-compilation")
COMPILATION_VERSION = config.get("compilation_version", "0.5.0-alpha2")
COMPILATION_ENABLED = config.get("enable_compilation", False)

if COMPILATION_ENABLED:
    if "compilation_config" not in config:
        config["compilation_config"] = {}

    config["compilation_config"]["wps_bin_dir"] = WPS_INSTALL_DIR
    config["compilation_config"]["wrf_bin_dir"] = WRF_INSTALL_DIR
    config["compilation_config"]["wps_version"] = WPS_VERSION
    config["compilation_config"]["wrf_version"] = WRF_VERSION
    config["compilation_config"]["toolchain_suffix"] = TOOLCHAIN_SUFFIX
    config["compilation_config"]["eessi_init_script"] = config["eessi_init_script"]

module wrf_wps_compilation:
    snakefile: f"gh:{COMPILATION_REPO}@{COMPILATION_VERSION}:workflow/Snakefile"
    config: config.get("compilation_config", {})

if COMPILATION_ENABLED:
    use rule audit_wps_status from wrf_wps_compilation as compilation_audit_wps
    use rule audit_wrf_status from wrf_wps_compilation as compilation_audit_wrf
    use rule compile_wps_via_eb from wrf_wps_compilation as compilation_exec_wps with:
        output:
            f"{WPS_INSTALL_DIR}/geogrid.exe",
            f"{WPS_INSTALL_DIR}/ungrib.exe",
            f"{WPS_INSTALL_DIR}/metgrid.exe"

    use rule compile_wrf_via_eb from wrf_wps_compilation as compilation_exec_wrf with:
        output:
            f"{WRF_INSTALL_DIR}/real.exe",
            f"{WRF_INSTALL_DIR}/wrf.exe"

    WPS_DEP = [
        f"{WPS_INSTALL_DIR}/geogrid.exe",
        f"{WPS_INSTALL_DIR}/ungrib.exe",
        f"{WPS_INSTALL_DIR}/metgrid.exe"
    ]
    WRF_DEP = [
        f"{WRF_INSTALL_DIR}/real.exe",
        f"{WRF_INSTALL_DIR}/wrf.exe"
    ]
# ==============================================================================

rule namelist_wps:
    output:
        str(Path(RUN_BASE_DIR_TEMPLATE) / "namelist.wps")
    params:
        geog_data_path=str(Path(config["geog_data_path"])),
        geo_em_path=GEO_EM_PATH,
        namelist_wps=config["namelist_wps"],
        GEOGRID_TBL=config["GEOGRID.TBL"],
        wps_dir=WPS_INSTALL_DIR,
        run_dir=lambda wildcards: get_run_dir(wildcards.year),
    shell:
        """
        mkdir -p {params.run_dir}
        cd {params.run_dir}
        jinja2 {params.namelist_wps} \
            -D start_year={wildcards.year} \
            -D end_year={wildcards.year} \
            -D geog_data_path={params.geog_data_path} \
            -o namelist.wps
        """

rule namelist_wps_geogrid:
    output:
        str(Path(GEO_EM_PATH) / "namelist.wps")
    params:
        geog_data_path=str(Path(config["geog_data_path"])),
        geo_em_path=GEO_EM_PATH,
        namelist_wps=config["namelist_wps"],
    shell:
        """
        mkdir -p {params.geo_em_path}
        cd {params.geo_em_path}
        jinja2 {params.namelist_wps} \
            -D geog_data_path={params.geog_data_path} \
            -o namelist.wps
        """

rule namelist_input:
    output:
        str(Path(RUN_BASE_DIR_TEMPLATE) / "namelist.input")
    params:
        run_dir=lambda wildcards: get_run_dir(wildcards.year),
        namelist_input_template=str(Path(config["namelist_input"])),
    shell:
        """
        mkdir -p {params.run_dir}
        cd {params.run_dir}
        jinja2 {params.namelist_input_template} \
            -D start_year={wildcards.year} \
            -D end_year={wildcards.year} \
            -o namelist.input
        """

