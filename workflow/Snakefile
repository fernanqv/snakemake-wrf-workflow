# # Instructions to run this workflow in altamira:
#
# # FIRST TIME ONLY
# git worktree add config/profiles hpc-profiles # this will load 'altamira' profile under 'config/profiles/altamira/'
# # FOR EVERY WORKFLOW RUN
# pixi run hpc-profile altamira

configfile: "config/config.yaml"

import os
from datetime import date, timedelta
from pathlib import Path
from shlex import quote

REPO_ROOT = Path(config.get("repo_root_custom", Path.cwd()))
PATH_KEYS = [
    ("run_dir",),
    ("ERA5", "grib_basedir"),
    ("ERA5", "download_script"),
    ("geog_data", "path"),
    ("geog_data", "download_script"),
    ("WPS", "install_dir"),
    ("WPS", "namelist_template"),
    ("WPS", "geogrid", "geo_em_path"),
    ("WRF", "install_dir"),
    ("WRF", "namelist_template"),
]
for keys in PATH_KEYS:
    section = config
    for key in keys[:-1]:
        section = section[key]
    key = keys[-1]
    if key in section:
        path_val = Path(section[key])
        if not path_val.is_absolute():
            section[key] = str(REPO_ROOT / path_val)

# Environment Initialization
RUN_BASE_DIR_TEMPLATE = config["run_dir"]

# WPS and WRF
WRF_INSTALL_DIR = config["WRF"]["install_dir"]
WPS_INSTALL_DIR = config["WPS"]["install_dir"]
MPI_LAUNCHER    = config["execution"].get("mpi_launcher", "mpirun")

# Profile's runtime environment
LOCAL_MODULES_PATH = config.get("local_modules_path", "")
WRF_VERSION        = config.get("wrf_version", "4.6.1")
WPS_VERSION        = config.get("wps_version", "4.6.0")
TOOLCHAIN_SUFFIX   = config.get("toolchain_suffix", "-foss-2024a-dmpar")

PROFILE_NAME    = config.get("profile_name", "local")
PROFILE_DIR     = f"config/profiles/{PROFILE_NAME}"
ENV_SCRIPT_PATH = str(REPO_ROOT / PROFILE_DIR / "set_env.sh")
WPS_RUNTIME_ENV = (
    f"export LOCAL_MODULES_PATH='{LOCAL_MODULES_PATH}'; "
    f"export WPS_VERSION='{WPS_VERSION}'; "
    f"export TOOLCHAIN_SUFFIX='{TOOLCHAIN_SUFFIX}'; "
    f"source '{ENV_SCRIPT_PATH}'; "
)
WRF_RUNTIME_ENV = (
    f"export LOCAL_MODULES_PATH='{LOCAL_MODULES_PATH}'; "
    f"export WRF_VERSION='{WRF_VERSION}'; "
    f"export TOOLCHAIN_SUFFIX='{TOOLCHAIN_SUFFIX}'; "
    f"source '{ENV_SCRIPT_PATH}'; "
)

# ERA5 settings
ERA5_DOMAIN = config["ERA5"]["domain"]
GRIB_BASE_DIR = config["ERA5"]["grib_basedir"]
ERA5_FILETYPES = ["pl", "sl"]
SIM_START = date.fromisoformat(config["simulation"]["start_date"])
SIM_DAYS = config["simulation"].get("days", 10)
RUN_DATES = [(SIM_START + timedelta(days=offset)).isoformat()
             for offset in range(SIM_DAYS)]
if SIM_START.day != 1:
    raise ValueError("simulation.start_date must be the first day of a month")
if not isinstance(SIM_DAYS, int) or not 1 <= SIM_DAYS <= 10:
    raise ValueError("simulation.days must be an integer between 1 and 10 (ERA5 coverage)")

# GEOGRID
GEO_EM_PATH = config["WPS"]["geogrid"]["geo_em_path"].format(era5_domain=ERA5_DOMAIN)
GEOG_DATA_PATH = str(Path(config["geog_data"]["path"]))
GEOG_DATA_URL = config["geog_data"].get(
    "url",
    "https://www2.mmm.ucar.edu/wrf/src/wps_files/geog_low_res_mandatory.tar.gz",
)
GEOG_DATA_INDEX = str(Path(GEOG_DATA_PATH) / "topo_gmted2010_5m" / "index")
GEOGRID_TBL = config["WPS"]["geogrid"].get("table", "GEOGRID.TBL.ARW")

# UNGRIB
VTABLE = config["WPS"].get("ungrib", {}).get("vtable", "Vtable.ERA-interim.pl")

# METGRID
METGRID_TBL = config["WPS"].get("metgrid", {}).get("table", "METGRID.TBL")

# WRF
WRF_RUN_EXCLUDE_PATTERNS = ["wrf*", "*.exe", "README*", "*rsl*", "namelist.*"]
WRF_RUN_FIND_EXCLUDES = " ".join(
    f"! -name {quote(pattern)}" for pattern in WRF_RUN_EXCLUDE_PATTERNS
)


def launch_command(executable, tasks, mpi):
    """Run directly for one task, or use the configured MPI launcher."""
    if tasks < 1:
        raise ValueError("tasks must be at least 1")
    executable = quote(str(executable))
    if tasks == 1:
        return executable
    return f"{mpi} -n {tasks} {executable}"


def get_run_dir(day):
    """Expand run_dir template with a simulation date."""
    return RUN_BASE_DIR_TEMPLATE.format(date=day)


def day_bounds(day):
    start = date.fromisoformat(day)
    end = start + timedelta(days=1)
    return start, end


def restart_path(day):
    return str(Path(get_run_dir(day)) / "wrf.restart")


def restart_filename(day):
    end = day_bounds(day)[1]
    return f"wrfrst_d01_{end:%Y-%m-%d}_00:00:00"


def previous_day(day):
    return (date.fromisoformat(day) - timedelta(days=1)).isoformat()

rule all:
    input:
        [str(Path(get_run_dir(day)) / "wrf.done") for day in RUN_DATES]

localrules: all, namelist_wps, namelist_wps_geogrid, namelist_input

# ==============================================================================
# INTEGRATION WITH WRF/WPS COMPILATION MODULE
# ==============================================================================
COMPILATION_REPO    = config.get("compilation_repo", "orviz/snakemake-wrf-wps-compilation")
COMPILATION_VERSION = config.get("compilation_version", "0.6.0")
COMPILATION_ENABLED = config.get("enable_compilation", False)
COMPILATION_CONFIG  = config.get("compilation_config", {})

COMPILATION_CONFIG["wps_install_dir"] = WPS_INSTALL_DIR
COMPILATION_CONFIG["wrf_install_dir"] = WRF_INSTALL_DIR

module wrf_wps_compilation:
    snakefile: f"gh:{COMPILATION_REPO}@{COMPILATION_VERSION}:workflow/Snakefile"
    config: COMPILATION_CONFIG

if COMPILATION_ENABLED:
    # 1. Audit rules
    use rule audit_wps_status from wrf_wps_compilation as compilation_audit_wps
    use rule audit_wrf_status from wrf_wps_compilation as compilation_audit_wrf

    # 2. Compilation rules
    use rule compile_wps from wrf_wps_compilation as compilation_exec_wps
    use rule compile_wrf from wrf_wps_compilation as compilation_exec_wrf

    # 3. Software link rules
    use rule create_wps_master_link from wrf_wps_compilation as compilation_link_wps with:
        output:
            wps_ready = "audit/wps_link_ready.txt"

    use rule create_wrf_master_link from wrf_wps_compilation as compilation_link_wrf with:
        output:
            wrf_ready = "audit/wrf_link_ready.txt"

    # 4. Fill in the dependencies
    WPS_DEP = [
        "audit/wps_link_ready.txt"
    ]
    WRF_DEP = [
        "audit/wrf_link_ready.txt"
    ]
else:
    # When compilation is disabled
    WPS_DEP = []
    WRF_DEP = []

# ==============================================================================


# Creates the run_dir for each day and generates the namelist.wps file using jinja2 templating.
rule namelist_wps:
    output:
        str(Path(RUN_BASE_DIR_TEMPLATE) / "namelist.wps")
    params:
        geog_data_path=str(Path(config["geog_data"]["path"])),
        namelist_wps=config["WPS"]["namelist_template"],
        run_dir=lambda wildcards: get_run_dir(wildcards.date),
        start_date=lambda wildcards: day_bounds(wildcards.date)[0].strftime("%Y-%m-%d_%H:%M:%S"),
        end_date=lambda wildcards: day_bounds(wildcards.date)[1].strftime("%Y-%m-%d_%H:%M:%S"),
    shell:
        """
        mkdir -p {params.run_dir}
        cd {params.run_dir}
        jinja2 {params.namelist_wps} \
            -D start_date={params.start_date} \
            -D end_date={params.end_date} \
            -D geog_data_path={params.geog_data_path} \
            -o namelist.wps
        """

# Creates 'geo_em_path' folder and generates the 'namelist.wps' file for geogrid using jinja2 templating.
rule namelist_wps_geogrid:
    output:
        str(Path(GEO_EM_PATH) / "namelist.wps")
    params:
        geog_data_path=str(Path(config["geog_data"]["path"])),
        geo_em_path=GEO_EM_PATH,
        namelist_wps=config["WPS"]["namelist_template"],
        start_date=SIM_START.strftime("%Y-%m-%d_00:00:00"),
        end_date=(SIM_START + timedelta(days=SIM_DAYS)).strftime("%Y-%m-%d_00:00:00"),
    shell:
        """
        mkdir -p {params.geo_em_path}
        cd {params.geo_em_path}
        jinja2 {params.namelist_wps} \
            -D start_date={params.start_date} \
            -D end_date={params.end_date} \
            -D geog_data_path={params.geog_data_path} \
            -o namelist.wps
        """

rule namelist_input:
    output:
        str(Path(RUN_BASE_DIR_TEMPLATE) / "namelist.input")
    params:
        run_dir=lambda wildcards: get_run_dir(wildcards.date),
        namelist_input_template=str(Path(config["WRF"]["namelist_template"])),
        start_year=lambda wildcards: day_bounds(wildcards.date)[0].year,
        start_month=lambda wildcards: day_bounds(wildcards.date)[0].month,
        start_day=lambda wildcards: day_bounds(wildcards.date)[0].day,
        end_year=lambda wildcards: day_bounds(wildcards.date)[1].year,
        end_month=lambda wildcards: day_bounds(wildcards.date)[1].month,
        end_day=lambda wildcards: day_bounds(wildcards.date)[1].day,
        restart=lambda wildcards: ".true." if wildcards.date != RUN_DATES[0] else ".false.",
    shell:
        """
        mkdir -p {params.run_dir}
        cd {params.run_dir}
        jinja2 {params.namelist_input_template} \
            -D start_year={params.start_year} \
            -D start_month={params.start_month} \
            -D start_day={params.start_day} \
            -D end_year={params.end_year} \
            -D end_month={params.end_month} \
            -D end_day={params.end_day} \
            -D restart={params.restart} \
            -o namelist.input
        """

# Download geographical data from geog_data.url to geog_data.path if missing
rule download_wps_geog:
    output:
        GEOG_DATA_INDEX
    params:
        download_script=config["geog_data"]["download_script"],
        url=GEOG_DATA_URL,
        target_dir=GEOG_DATA_PATH,
        required_file="topo_gmted2010_5m/index",
    shell:
        """
        bash {params.download_script:q} \
            {params.url:q} \
            {params.target_dir:q} \
            {params.required_file:q}
        """


rule geogrid:
    input:
        geog_data=GEOG_DATA_INDEX,
        namelist_wps=str(Path(GEO_EM_PATH) / "namelist.wps"),
        compilation=WPS_DEP
    output:
        done = str(Path(GEO_EM_PATH) / "geogrid.done"),
        nc   = str(Path(GEO_EM_PATH) / "geo_em.d01.nc")
    params:
        geo_em_path=GEO_EM_PATH,
        GEOGRID_TBL=GEOGRID_TBL,
        wps_install_dir=WPS_INSTALL_DIR,
        runtime_env=WPS_RUNTIME_ENV,
        command=lambda wildcards, resources: launch_command(
            Path(WPS_INSTALL_DIR) / "geogrid.exe", resources.tasks, resources.mpi
        ),
    resources:
        tasks=int(config["WPS"].get("geogrid", {}).get("tasks", 1)),
        cpus_per_task=1,
        mem_mb_per_cpu=int(config["WPS"].get("geogrid", {}).get("mem_mb_per_cpu", 2000)),
        mpi=MPI_LAUNCHER if int(config["WPS"].get("geogrid", {}).get("tasks", 1)) > 1 else "",
    shell:
        """
        {params.runtime_env}

        cd {params.geo_em_path}
        mkdir -p geogrid

        ln -sf {params.wps_install_dir}/geogrid/{params.GEOGRID_TBL} geogrid/GEOGRID.TBL

        {params.command}

        test -s geo_em.d01.nc

        touch {output.done}
        """

rule download_ERA5:
    output:
        f"{GRIB_BASE_DIR}/{{domain}}/{{year}}/ERA5-{{year}}{{month}}-{{filetype}}.grib"
    params:
        download_script=config["ERA5"]["download_script"],
        data_dir=GRIB_BASE_DIR,
    shell:
        """
        echo "Running ERA5 download for {wildcards.year}-{wildcards.month} ({wildcards.filetype}, {wildcards.domain})"
        python {params.download_script:q} {wildcards.year} {wildcards.month} {wildcards.filetype} {params.data_dir:q} {wildcards.domain}
        """

rule ungrib:
    input:
        gribs=lambda wildcards: expand(
            f"{GRIB_BASE_DIR}/{ERA5_DOMAIN}/{{year}}/ERA5-{{year}}{{month}}-{{filetype}}.grib",
            year=SIM_START.year,
            month=[f"{SIM_START.month:02d}"],
            filetype=ERA5_FILETYPES,
        ),
        namelist_wps=lambda wildcards: str(Path(get_run_dir(wildcards.date)) / "namelist.wps"),
        compilation=WPS_DEP
    output:
        str(Path(RUN_BASE_DIR_TEMPLATE) / "ungrib.done")
    params:
        run_dir=lambda wildcards: get_run_dir(wildcards.date),
        VTable=VTABLE,
        wps_install_dir=WPS_INSTALL_DIR,
        runtime_env=WPS_RUNTIME_ENV,
    resources:
        tasks=1,
        cpus_per_task=1,
        mem_mb_per_cpu=int(config["WPS"].get("ungrib", {}).get("mem_mb_per_cpu", 10000)),
    shell:
        """
        {params.runtime_env}

        cd {params.run_dir}

        # Link GRIB files
        csh {params.wps_install_dir}/link_grib.csh {input.gribs}

        # Link Vtable
        ln -sf {params.wps_install_dir}/ungrib/Variable_Tables/{params.VTable} Vtable

        {params.wps_install_dir}/ungrib.exe

        touch {output}
        """

rule metgrid:
    input:
        ungrib=lambda wildcards: str(Path(get_run_dir(wildcards.date)) / "ungrib.done"),
        geogrid_done=str(Path(GEO_EM_PATH) / "geogrid.done"),
        geogrid_nc=str(Path(GEO_EM_PATH) / "geo_em.d01.nc"),
        compilation=WPS_DEP
    output:
        str(Path(RUN_BASE_DIR_TEMPLATE) / "metgrid.done")
    params:
        run_dir=lambda wildcards: get_run_dir(wildcards.date),
        METGRID_TBL=METGRID_TBL,
        wps_install_dir=WPS_INSTALL_DIR,
        runtime_env=WPS_RUNTIME_ENV,
        command=lambda wildcards, resources: launch_command(
            Path(WPS_INSTALL_DIR) / "metgrid.exe", resources.tasks, resources.mpi
        ),
    resources:
        tasks=int(config["WPS"].get("metgrid", {}).get("tasks", 1)),
        cpus_per_task=1,
        mem_mb_per_cpu=int(config["WPS"].get("metgrid", {}).get("mem_mb_per_cpu", 2000)),
        mpi=MPI_LAUNCHER if int(config["WPS"].get("metgrid", {}).get("tasks", 1)) > 1 else "",
    shell:
        """
        {params.runtime_env}

        echo "Running metgrid for date {wildcards.date} in {params.run_dir}"
        cd {params.run_dir}
        mkdir -p metgrid

        ln -sf {input.geogrid_nc} ./geo_em.d01.nc

        ln -sf {params.wps_install_dir}/metgrid/{params.METGRID_TBL} metgrid/METGRID.TBL

        {params.command}

        touch {output}
        """

rule real:
    input:
        metgrid=lambda wildcards: str(Path(get_run_dir(wildcards.date)) / "metgrid.done"),
        namelist_input=lambda wildcards: str(Path(get_run_dir(wildcards.date)) / "namelist.input"),
        compilation=WRF_DEP
    output:
        str(Path(RUN_BASE_DIR_TEMPLATE) / "real.done")
    params:
        date=lambda wildcards: wildcards.date,
        run_dir=lambda wildcards: get_run_dir(wildcards.date),
        wrf_install_dir=WRF_INSTALL_DIR,
        runtime_env=WRF_RUNTIME_ENV,
        command=lambda wildcards, resources: launch_command(
            Path(WRF_INSTALL_DIR) / "main/real.exe", resources.tasks, resources.mpi
        ),
    resources:
        tasks=int(config["WRF"].get("real", {}).get("tasks", 1)),
        cpus_per_task=1,
        mem_mb_per_cpu=int(config["WRF"].get("real", {}).get("mem_mb_per_cpu", 2000)),
        mpi=MPI_LAUNCHER if int(config["WRF"].get("real", {}).get("tasks", 1)) > 1 else "",
    shell:
        """
        {params.runtime_env}

        echo "Running real for date {params.date} in {params.run_dir}"
        cd {params.run_dir}

        {params.command}

        touch {output}
        """

rule wrf:
    input:
        real=lambda wildcards: str(Path(get_run_dir(wildcards.date)) / "real.done"),
        previous_done=lambda wildcards: (
            str(Path(get_run_dir(previous_day(wildcards.date))) / "wrf.done")
            if wildcards.date != RUN_DATES[0] else []
        ),
        restart=lambda wildcards: (
            restart_path(previous_day(wildcards.date))
            if wildcards.date != RUN_DATES[0] else []
        ),
        compilation=WRF_DEP
    output:
        done=str(Path(RUN_BASE_DIR_TEMPLATE) / "wrf.done"),
        restart=str(Path(RUN_BASE_DIR_TEMPLATE) / "wrf.restart")
    params:
        run_dir=lambda wildcards: get_run_dir(wildcards.date),
        is_restart=lambda wildcards: wildcards.date != RUN_DATES[0],
        restart_name=lambda wildcards: restart_filename(wildcards.date),
        incoming_restart_name=lambda wildcards: f"wrfrst_d01_{wildcards.date}_00:00:00",
        restart_source=lambda wildcards: (
            restart_path(previous_day(wildcards.date))
            if wildcards.date != RUN_DATES[0] else ""
        ),
        wrf_run_dir=str(Path(WRF_INSTALL_DIR) / "run"),
        wrf_run_find_excludes=WRF_RUN_FIND_EXCLUDES,
        wrf_install_dir=WRF_INSTALL_DIR,
        runtime_env=WRF_RUNTIME_ENV,
        command=lambda wildcards, resources: launch_command(
            Path(WRF_INSTALL_DIR) / "main/wrf.exe", resources.tasks, resources.mpi
        ),
    resources:
        tasks=int(config["WRF"].get("wrf", {}).get("tasks", 1)),
        cpus_per_task=1,
        mpi=MPI_LAUNCHER if int(config["WRF"].get("wrf", {}).get("tasks", 1)) > 1 else "",
        mem_mb_per_cpu=int(config["WRF"].get("wrf", {}).get("mem_mb_per_cpu", 2000)),
    shell:
        """
        {params.runtime_env}

        echo "Running wrf for date {wildcards.date} in {params.run_dir}"
        mkdir -p {params.run_dir}
        cd {params.run_dir}

        find {params.wrf_run_dir} -maxdepth 1 -mindepth 1 \
            {params.wrf_run_find_excludes} \
            -exec ln -sf {{}} . \\;

        echo "Running wrf with {resources.tasks} task(s)"
        if [ "{params.is_restart}" = "True" ]; then
            ln -sf {params.restart_source:q} {params.incoming_restart_name:q}
        fi
        {params.command}

        test -s {params.restart_name:q}
        ln -sf {params.restart_name:q} {output.restart:q}
        test -s {output.restart:q}
        touch {output.done}
        """
